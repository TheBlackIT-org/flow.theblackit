# =====================================================================
# BlackIT Flow — Apache/LiteSpeed config for Hostinger.
#
# `_redirects` in this folder is for Cloudflare Pages / Netlify and is ignored
# here; these are the rules that Apache actually honours.
# =====================================================================

# ---- SPA fallback ---------------------------------------------------
# The app is one page. Anything that is not a real file serves index.html so a
# deep link or a stray path lands on the app instead of a 404. `.htaccess`
# itself is excluded so this file can never be served as content.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^\.htaccess$ - [F,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# ---- Don't advertise the stack --------------------------------------
ServerSignature Off

# ---- Compression ----------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---- Caching --------------------------------------------------------
# `_astro/*` filenames carry a content hash, so they can never go stale: cache
# them hard. index.html holds the hash references, so it must always be
# revalidated or a deploy would keep serving the previous build.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # The app is an internal tool; keep it out of search engines. This backs up
  # the noindex meta tag and public/robots.txt.
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>

# ---- The anon key ships in the bundle by design ---------------------
# No rule here restricts access. There is no sign-in: anyone with the URL can
# read and write the shared workspace. Put an identity gate in front of the
# domain if the contents need protecting.
