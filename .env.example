# Copy to .env and fill in from Supabase → Settings → API.
# Leave these empty and the app runs browser-local instead (demo mode).
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
PUBLIC_SEED_SAMPLE=false

# Require a signed-in account before the board is shown.
#
# Default (unset/false) is the pre-sign-in behaviour: no gate at all. Turn it on
# only AFTER applying supabase/migrations/0003_member_identity.sql and enabling
# the GitHub provider — otherwise nobody can reach the board.
#
# This is inlined at build time. Changing it on the host requires a rebuild.
PUBLIC_REQUIRE_LOGIN=false
