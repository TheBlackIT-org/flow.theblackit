# =====================================================================
# BlackIT Flow — Apache/LiteSpeed config, served from the document root.
#
# Hostinger's Git deploy copies the WHOLE repository here, so the build output
# (`index.html`, `_astro/`) shares this directory with the source tree. The
# first block locks the source down; the rest serves the app.
#
# `_redirects` alongside this file is for Cloudflare Pages / Netlify and is
# ignored by Apache — these rules are what actually take effect.
# =====================================================================

# ---- Keep the source tree private -----------------------------------
# Everything here is either a build input, a dev tool or a project secret.
# Without this the whole repository is downloadable from the web root.
RedirectMatch 404 ^/(src|test|tools|supabase|docs|node_modules|\.git)(/|$)
<FilesMatch "^(\..*|package(-lock)?\.json|astro\.config\.mjs|vitest\.config\.ts|tsconfig\.json|env\.d\.ts|README\.md)$">
  Require all denied
</FilesMatch>

# No directory listings: a missing index must 404, never enumerate.
Options -Indexes

# ---- SPA fallback ---------------------------------------------------
# The app is one page. Anything that is not a real file serves index.html so a
# deep link or a stray path lands on the app instead of a 404.
# ---- Serve the build from dist/ -------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^\.htaccess$ - [F,L]

  # A real file in dist/ (CSS, JS, images) → serve it from there
  RewriteCond %{REQUEST_URI} !^/dist/
  RewriteCond %{DOCUMENT_ROOT}/dist%{REQUEST_URI} -f
  RewriteRule ^(.*)$ dist/$1 [L]

  # Everything else → the app's page in dist/
  RewriteCond %{REQUEST_URI} !^/dist/
  RewriteRule ^ dist/index.html [L]
</IfModule>

ServerSignature Off

# ---- Compression ----------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---- Caching --------------------------------------------------------
# `_astro/*` filenames carry a content hash, so they can never go stale: cache
# them hard. index.html holds those hash references, so it must always be
# revalidated or a deploy would keep serving the previous build.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Internal tool; backs up the noindex meta tag.
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>

# ---- No access control here -----------------------------------------
# There is no sign-in: anyone with the URL can read and write the shared
# workspace. Put an identity gate (e.g. Cloudflare Access) in front of the
# domain if the contents need protecting.
