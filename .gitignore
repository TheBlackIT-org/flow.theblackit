node_modules/

# Secrets and local overrides. .env.example is the committed template.
.env
.env.local
# The build output is COMMITTED on purpose.
#
# Hostinger's hPanel Git deploy copies files into the document root and does
# not run a build, so the built site has to be in the repository. `dist/` is
# the intermediate Astro writes to; `npm run build:deploy` promotes its
# contents (index.html, _astro/, .htaccess, …) to the root, where Apache
# serves them. Run it before committing any source change.
.npm-cache/
.chrome-profile*/
shot*.png
/header*.png
/mobile*.png
/full.png
/*-crop.png
*.log
.DS_Store
